{
  "env": {
    "browser": true,
    "commonjs": true,
    "es6": true,
    "jest": true,
    "node": true
  },
  "extends": "eslint:recommended",
  "globals": {
    "Atomics": "readonly",
    "SharedArrayBuffer": "readonly"
  },
  "parserOptions": {
    "ecmaVersion": 6
  },
  "plugins": [
    "jsdoc"
  ],
  "parser": "babel-eslint",
  "rules": {
    "jsdoc/require-description": 1,
    "indent": ["error", 2],
    "semi": [2, "never"],
    "callback-return": ["error", ["done", "send.error", "send.success", "res", "res.json", "res.send", "res.sendStatus", "res.status"]],
    "no-unused-vars": [2, {"vars": "local", "args": "none"}],
    "no-console": "off"
  }
}
